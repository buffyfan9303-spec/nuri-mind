{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/unse", "destination": "/api/unse" },
    { "source": "/unse/:zodiac", "destination": "/api/unse?z=:zodiac" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
