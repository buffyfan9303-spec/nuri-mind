# Google AdSense (애드센스 승인 후 입력 — 입력 시 플레이스홀더가 실광고로 자동 전환)
VITE_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
VITE_ADSENSE_SLOT_BANNER=0000000000
VITE_ADSENSE_SLOT_RECT=0000000000

# 선택 — 비워 두면 해당 기능만 꺼진다(no-op). Vercel에는 현재 미등록(2026-09 점검).
# VITE_SENTRY_DSN=https://xxxx@xxxx.ingest.sentry.io/xxxx   # 에러 모니터링(src/lib/sentry.ts)
# VITE_GA_ID=G-XXXXXXXXXX                                     # GA4(src/lib/analytics.ts)
# VITE_KAKAO_KEY=                                             # 카카오 공유 SDK JS 키(로그인과 별개 — 로그인은 Supabase Kakao provider)
# VITE_VAPID_PUBLIC_KEY=                                      # 웹 푸시 공개키(미설정 시 src/lib/push.ts 기본값 — 엣지 VAPID_PRIVATE_KEY와 쌍)
